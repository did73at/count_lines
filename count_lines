#!/bin/sh

ERROR_COUNT=0

lines_count() {
    line_nb="$(cat "$1" | grep -nE "^[{}]$" | cut -f 1 -d ":")"
    echo "$line_nb" > trash_lines_count
    n=0
    while read -r line; do
        if [ "$n" -eq 0 ]; then
            n="$line"
        else
            FUN="$(cat "$1" | head -n "$((n - 1))" | tail -n 1)"
            n="$(cat "$1" | head -n "$line" | tail -n $((line + 1 - n)) | grep -E "^[ ]+[^ +-/|&*%].*[);]$" | wc -l)"
            if [ $n -gt 30 ]; then
                ERROR_COUNT=$((ERROR_COUNT + 1))
                echo "\033[31m$FUN"
                echo "\033[0m>> $n lines"
            else
                echo "\033[32m$FUN"
                echo "\033[0m>> $n lines"
            fi
            echo "\033[0m"
            n=0
        fi
    done < trash_lines_count
}

for i in "$@"; do
    a="|     $i     |"
    b="$(echo "$a" | tr "a-z_. |" "-")"
    echo "\033[34m$b"
    echo "$a"
    echo "$b"
    echo "\033[0m"
    case "$i" in
        *.c)
            lines_count "$i"
            ;;
        *)
            echo "$i is not a C file"
            continue
            ;;
    esac
done

if [ $ERROR_COUNT -ne 0 ]; then
    echo "\033[31m!!!!!!!!!!!!!!!! WARNING !!!!!!!!!!!!!!!!"
    echo "There are too many lines in $ERROR_COUNT function(s)"
    echo "\033[0m"
fi
rm trash_lines_count 2>/dev/null
